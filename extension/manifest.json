{
  "manifest_version": 3,
  "name": "SpeedGrader LLM Link Check",
  "version": "1.2.0",
  "description": "Find LLM-related UTM referral parameters in links displayed in ASU Canvas SpeedGrader.",
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["https://canvas.asu.edu/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SpeedGrader LLM Link Check" },
  "content_scripts": [{
    "matches": ["https://canvas.asu.edu/courses/*/gradebook/speed_grader*"],
    "js": ["panel.js"],
    "run_at": "document_idle"
  }]
}
